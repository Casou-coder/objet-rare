# Copier en .env (jamais commité)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/vault

# firebase (production) | dev (local uniquement : jeton "dev:<uid>:<email>")
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Compte de service Firebase Admin, au choix :
# - en local : chemin vers le fichier JSON, rangé HORS du dépôt
GOOGLE_APPLICATION_CREDENTIALS=
# - en hébergement : contenu du JSON encodé en base64 (variable secrète de l'hébergeur)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# s3 (production) | memory (local uniquement)
STORAGE_MODE=memory
S3_BUCKET=vault-documents
S3_REGION=eu-west-3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

SIGNED_URL_TTL_SECONDS=300
WATERMARK_CERTIFICATES=true
WATERMARK_PHOTOS=false
REVENUECAT_WEBHOOK_SECRET=
