{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-cli/schema/eas.schema.json",
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "enterpriseProvisioning": "universal"
      },
      "env": { "APP_ENV": "preview" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "clement.dupas@hotmail.fr",
        "ascAppId": "FILL_AFTER_CREATING_APP_IN_APP_STORE_CONNECT",
        "appleTeamId": "FILL_FROM_DEVELOPER_ACCOUNT_MEMBERSHIP_PAGE"
      }
    }
  }
}
