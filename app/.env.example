# Copier ce fichier en .env et remplir avec les vraies valeurs.
# Ne JAMAIS committer le .env (il est dans .gitignore).

# Supabase — récupéré dans Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# RevenueCat (paiements Premium) — Dashboard RevenueCat → Project Settings → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog (analytics) — optionnel
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
