# Copier en .env (jamais commité).

# URL de l'API Vault. En local avec Expo Go : l'adresse IP du PC sur le Wi-Fi, ex. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Adresse du support (bouton « Contacter le support » masqué si vide)
EXPO_PUBLIC_SUPPORT_EMAIL=

# RevenueCat — Dashboard RevenueCat → Project Settings → API Keys (étape 6)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob (bannières Free) — identifiants de test Google utilisés si vide
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
