{
  "expo": {
    "name": "Objet Rare",
    "slug": "objet-rare",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "objetrare",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clementdupas.objetrare"
    },
    "android": {
      "package": "com.clementdupas.objetrare",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app a besoin d'accéder à vos photos pour ajouter des images à vos objets et documents.",
          "cameraPermission": "L'app a besoin d'accéder à votre caméra pour photographier vos objets."
        }
      ],
      "expo-font",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Des données anonymes et agrégées nous aident à améliorer l'application. Aucune donnée personnelle n'est collectée ni revendue."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A84C"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Objet Rare utilise Face ID pour protéger l'accès à ta collection et tes documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
